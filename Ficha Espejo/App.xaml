<Application x:Class="Ficha_Espejo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <LinearGradientBrush x:Key="RosyBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFECE6" Offset="0" />
            <GradientStop Color="#FFD8E6" Offset="0.5" />
            <GradientStop Color="#FFF4DDEE" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBackground" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#9C2F5A"/>
    </Application.Resources>
</Application>
