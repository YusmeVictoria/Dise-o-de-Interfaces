<Window x:Class="Ficha_Espejo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ficha Espejo" Height="450" Width="800"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None">
    <Border CornerRadius="20" Padding="16" Background="White" Opacity="0.98" BorderBrush="#26A0A0A0" BorderThickness="1">
        <Grid Background="{StaticResource RosyBackground}" ClipToBounds="True" CornerRadius="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Ficha espejo" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" Margin="8" />
            <Grid Grid.Row="1" Margin="8" ColumnDefinitions="3*,2*">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="14" Padding="20" Background="{StaticResource CardBackground}" BorderBrush="#33C46FA0" BorderThickness="1" Effect="{DynamicResource {x:Static SystemParameters.DropShadowKey}}">
                    <StackPanel>
                        <TextBlock Text="Origen" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                        <StackPanel Margin="0,16,0,8">
                            <TextBlock Text="Nombre" FontWeight="SemiBold" Foreground="#663647"/>
                            <TextBox x:Name="NameInput" Height="34" FontSize="14" Padding="8"
                                     Background="White" BorderBrush="#FFDAA4C9" BorderThickness="1.5"/>
                        </StackPanel>
                        <StackPanel Margin="0,8">
                            <TextBlock Text="Edad" FontWeight="SemiBold" Foreground="#663647"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Slider x:Name="AgeSlider" Minimum="0" Maximum="100" Value="24" Width="180" />
                                <Border Background="#FFDAA4C9" CornerRadius="8" Padding="8,4" >
                                    <TextBlock Text="{Binding Value, ElementName=AgeSlider, StringFormat='{}{0} años'}" FontWeight="SemiBold" Foreground="#9C2F5A"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Estado" FontWeight="SemiBold" Foreground="#663647"/>
                            <ComboBox x:Name="StatusCombo" Width="180" SelectedIndex="0" Background="White" BorderBrush="#FFDAA4C9" BorderThickness="1.5"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="Activo" />
                                <ComboBoxItem Content="En pausa" />
                                <ComboBoxItem Content="Inactivo" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="16,0,0,0" CornerRadius="14" Padding="20" Background="{StaticResource CardBackground}" BorderBrush="#33C46FA0" BorderThickness="1" Effect="{DynamicResource {x:Static SystemParameters.DropShadowKey}}">
                    <StackPanel>
                        <TextBlock Text="Destino (espejo)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,8" VerticalAlignment="Center">
                            <Ellipse Width="64" Height="64" Fill="#FFFFFFFF" Opacity="0.65" Stroke="#FFDAA4C9" StrokeThickness="2" />
                            <StackPanel Margin="12,0">
                                <TextBlock Text="{Binding Text, ElementName=NameInput}" FontSize="18" FontWeight="Bold" Foreground="#9C2F5A" />
                                <TextBlock Text="{Binding Value, ElementName=AgeSlider, StringFormat='{}Edad: {0}'}" FontSize="14" Foreground="#663647" />
                            </StackPanel>
                        </StackPanel>
                        <Border CornerRadius="10" Background="#FFF2CDE5" Padding="12" BorderBrush="#FFD08BC8" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Estado" FontWeight="SemiBold" Foreground="#663647"/>
                                    <Rectangle Width="8" Height="8" Fill="#FFD08BC8" RadiusX="4" RadiusY="4" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedValue, ElementName=StatusCombo}" FontSize="16" FontWeight="Bold" Foreground="#9C2F5A" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" CornerRadius="12" Background="#66FFFFFF" Padding="10" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <TextBlock Text="Los datos cambian en vivo gracias al binding con ElementName."
                                       TextWrapping="Wrap" Foreground="#884257" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
